---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportSection from '../../components/ReportSection.astro';
import { getReport } from '../../lib/blob';

const { date, slug } = Astro.params;
let report;
try {
  report = await getReport(date!, slug!);
} catch {
  return Astro.redirect('/404', 404);
}
---

<BaseLayout title={report.title}>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <a href="/" class="inline-flex items-center gap-1 text-sm text-accent hover:text-accent-muted mb-6 no-underline">
      ← Feed
    </a>

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full border text-text-muted border-border">
          {report.date}
        </span>
        {report.tags.map(tag => (
          <span class="text-xs px-2 py-0.5 rounded bg-surface-3 text-text-muted">{tag}</span>
        ))}
      </div>
      <h1 class="text-2xl font-bold text-text-primary">{report.title}</h1>
      {report.generatedAt && (
        <p class="text-xs text-text-muted mt-2">Generated {report.generatedAt}</p>
      )}
    </header>

    {report.sections.map(section => <ReportSection section={section} />)}
  </div>
</BaseLayout>
