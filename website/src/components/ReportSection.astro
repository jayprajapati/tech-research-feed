---
import type { Section } from '../lib/blob';
import DataTable from './DataTable.astro';

const { section }: { section: Section } = Astro.props;

const tierColors: Record<string, string> = {
  'TIER 1': 'bg-emerald-500/10 text-emerald-400',
  'TIER 2': 'bg-blue-500/10 text-blue-400',
  'TIER 3': 'bg-amber-500/10 text-amber-400',
  'SKIP': 'bg-red-500/10 text-red-400',
};

function isTable(content: any): content is { headers: string[]; rows: string[][] } {
  return content && typeof content === 'object' && 'headers' in content && 'rows' in content;
}
---

<section class="mb-8">
  {section.heading && (
    <h2 class="text-lg font-semibold text-text-primary mb-3">{section.heading}</h2>
  )}

  {section.type === 'text' && (
    <div class="text-sm text-text-primary leading-relaxed whitespace-pre-wrap">
      {typeof section.content === 'string' ? section.content : ''}
    </div>
  )}

  {section.type === 'table' && isTable(section.content) && (
    <DataTable data={section.content} />
  )}

  {section.type === 'cards' && Array.isArray(section.content) && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {(section.content as any[]).map(card => (
        <div class="bg-surface-2 border border-border rounded-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-semibold text-sm text-text-primary">{card.name}</h3>
            {card.tier && (
              <span class="text-xs font-bold px-2 py-0.5 rounded {tierColors[card.tier] || 'bg-surface-3 text-text-muted'}">
                {card.tier}
              </span>
            )}
          </div>
          <p class="text-xs text-text-muted">{card.reasoning}</p>
        </div>
      ))}
    </div>
  )}
</section>
