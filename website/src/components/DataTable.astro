---
import type { Table } from '../lib/blob';

const { data }: { data: Table } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="w-full text-sm border-collapse">
    {data.caption && (
      <caption class="text-xs text-text-muted text-left mb-2">{data.caption}</caption>
    )}
    <thead>
      <tr class="border-b border-border">
        {data.headers.map(h => (
          <th class="text-left py-2 px-3 font-semibold text-text-primary whitespace-nowrap">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {data.rows.map(row => (
        <tr class="border-b border-border/50 hover:bg-surface-3/50">
          {row.map(cell => (
            <td class="py-2 px-3 text-text-primary whitespace-nowrap">{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
